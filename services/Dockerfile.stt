# Speech-to-text server (Parakeet via sherpa-onnx, or faster-whisper). GPU build by default; for CPU pass
#   --build-arg BASE=python:3.11-slim
ARG BASE=nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04
FROM ${BASE}
RUN if command -v apt-get >/dev/null; then apt-get update && \
      apt-get install -y --no-install-recommends python3 python3-pip ffmpeg && \
      rm -rf /var/lib/apt/lists/*; fi
RUN (command -v pip3 || ln -s "$(command -v pip)" /usr/local/bin/pip3) && \
    pip3 install --no-cache-dir faster-whisper==1.2.1 sherpa-onnx==1.13.8 numpy fastapi==0.115.6 "uvicorn[standard]==0.34.0" python-multipart==0.0.20
WORKDIR /app
COPY stt_server.py .
EXPOSE 8001
CMD ["python3", "-m", "uvicorn", "stt_server:app", "--host", "0.0.0.0", "--port", "8001"]
