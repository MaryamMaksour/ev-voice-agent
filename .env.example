# Copy to .env and fill in. The LLM is always Ollama; pick where it runs.

# --- LiveKit (self-hosted) ---------------------------------------------------
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
# at least 32 characters
LIVEKIT_API_SECRET=change-me-to-a-long-random-secret-0123456789

# --- Call settings -----------------------------------------------------------
COMPANY_NAME=Horizon Realty
AGENT_PERSONA_NAME=Alex
CALL_TIMEZONE=UTC
DEFAULT_LEAD_ID=L001

# --- CRM ---------------------------------------------------------------------
CRM_BACKEND=sqlite
CRM_SQLITE_PATH=data/crm.db
# CRM_BACKEND=zoho
# ZOHO_CLIENT_ID=
# ZOHO_CLIENT_SECRET=
# ZOHO_REFRESH_TOKEN=
# ZOHO_DC=com
# ZOHO_SANDBOX=true

# --- LLM: Ollama --------------------------------------------------------------
# qwen3:8b or qwen3:14b
LLM_MODEL=qwen3:8b
LLM_API_KEY=ollama

# Laptop (Ollama installed natively) and EC2 (docker-compose.yml sets the URLs itself):
LLM_BASE_URL=http://localhost:11434/v1
STT_BASE_URL=http://localhost:8001/v1
TTS_BASE_URL=http://localhost:8880/v1

# RunPod pod (see deploy/runpod_start.sh):
# LLM_BASE_URL=https://<POD_ID>-11434.proxy.runpod.net/v1
# STT_BASE_URL=https://<POD_ID>-8001.proxy.runpod.net/v1
# TTS_BASE_URL=http://localhost:8880/v1

TTS_VOICE=af_heart

# seconds the agent waits for the LLM's first word (laptops running Qwen3 partly on CPU are slow)
LLM_TIMEOUT=60
# EC2 only: parallel LLM requests (concurrent calls) Ollama serves per model
# OLLAMA_NUM_PARALLEL=16

# --- Phone calls through 3CX (python -m agent.dial --lead L003) -------------------------
# The LiveKit SIP outbound trunk that points at 3CX (create it once with the LiveKit CLI or API).
# Empty = browser and console calls only.
# SIP_OUTBOUND_TRUNK_ID=ST_xxxxxxxxxxxx
# seconds to let the phone ring before it counts as "no answer"
RING_TIMEOUT=30
# where "transfer to a person" goes: a 3CX extension or a number. Empty = the agent offers a callback.
# HUMAN_TRANSFER_TO=sip:201@your-3cx-host
# HUMAN_TRANSFER_TO=tel:+97140000000

# --- Call recording (LiveKit Egress service needed, see README) --------------------------
RECORDING_ENABLED=0
# {room} and {lead} are filled in. Without S3 the file stays on the egress server's disk.
RECORDING_FILEPATH=recordings/{room}.ogg
# RECORDING_S3_BUCKET=ev-call-recordings
# RECORDING_S3_REGION=me-central-1
