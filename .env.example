# Copy to .env and fill in. One file for the server (docker compose) and the laptop (agent.talk).

# --- LiveKit (self-hosted on the company GPU server) -----------------------------
# On the server, docker-compose.yml overrides this with ws://127.0.0.1:7880.
# On a laptop, point it at the server: ws://<server-ip>:7880
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
# at least 32 characters
LIVEKIT_API_SECRET=change-me-to-a-long-random-secret-0123456789
# LiveKit is on the LAN, so the agent connects to it directly. Set this only if it must go through a proxy.
# LIVEKIT_HTTP_PROXY=

# --- Call settings ---------------------------------------------------------------
COMPANY_NAME=Evolutions
AGENT_PERSONA_NAME=Alex
# UAE time: used for "today", callback dates and the calling rules below
CALL_TIMEZONE=Asia/Dubai
DEFAULT_LEAD_ID=L001

# --- Calling rules (checked before every phone call; see agent/compliance.py) --------
# A blocked dial is not made. It is written to BLOCKED_DIR/<date>.jsonl for the dashboard.
MAX_CALLS_PER_DAY=1
MAX_CALLS_PER_WEEK=2
# never call leads with these CRM statuses (and never a lead marked do-not-call)
BLOCKED_STATUSES=not_interested,do_not_call,wrong_number
# e.g. 09:00-18:00 in CALL_TIMEZONE; empty = any time (24/7)
CALL_HOURS=
BLOCKED_DIR=data/blocked

# --- CRM ---------------------------------------------------------------------------
CRM_BACKEND=sqlite
CRM_SQLITE_PATH=data/crm.db
# CRM_BACKEND=zoho
# ZOHO_CLIENT_ID=
# ZOHO_CLIENT_SECRET=
# ZOHO_REFRESH_TOKEN=
# ZOHO_DC=com
# ZOHO_SANDBOX=true

# --- LLM: Qwen3.5-9B. vLLM in production, Ollama for testing ----------------------
# Only these two lines change between the two. Everything else in the code stays the same.
#
#   Testing (laptop, Ollama):   LLM_BASE_URL=http://localhost:11434/v1   LLM_MODEL=qwen3.5:9b
#                               (first: ollama pull qwen3.5:9b ; on a small GPU qwen3:8b also works)
#   Production (vLLM server):   LLM_BASE_URL=http://<server-ip>:8000/v1  LLM_MODEL=qwen3.5-9b
#                               (on the server docker-compose.yml sets the URL itself)
#
# LLM_BACKEND (vllm / ollama) is worked out from the URL: port 11434 = Ollama.
# Set it only if Ollama runs on another port.
# LLM_BACKEND=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3.5:9b

# --- vLLM server settings (services/docker-compose.yml reads these; the laptop ignores them)
# the name vLLM serves the model under; the agent on the server uses it as its LLM_MODEL
VLLM_SERVED_NAME=qwen3.5-9b
# Hugging Face model vLLM downloads and serves
VLLM_MODEL=Qwen/Qwen3.5-9B
# empty = no key. If set, vLLM requires it and the agent sends it.
LLM_API_KEY=
LLM_TEMPERATURE=0.3
# seconds the agent waits for the LLM's first token
LLM_TIMEOUT=30
# vLLM tuning (services/docker-compose.yml):
#   share of GPU memory for vLLM; STT and TTS use the rest
VLLM_GPU_UTIL=0.55
VLLM_MAX_MODEL_LEN=16384
#   calls answered at the same time
VLLM_MAX_NUM_SEQS=48
#   24 GB GPU: VLLM_EXTRA_ARGS=--quantization fp8   and VLLM_GPU_UTIL=0.6
# VLLM_EXTRA_ARGS=
# VLLM_IMAGE_TAG=v0.27.1
# HF_TOKEN=

# Speech service URLs. On the server docker-compose.yml sets these itself (127.0.0.1).
# On a laptop: localhost with services/docker-compose.local.yml, or the server's address.
STT_BASE_URL=http://localhost:8001/v1
TTS_BASE_URL=http://localhost:8880/v1

STT_MODEL=whisper-1
TTS_VOICE=af_heart
# model = LiveKit's local turn detector (needs `python -m agent.main download-files`); vad = silence only
TURN_DETECTION=model

# --- Post-call work (runs inside the agent after each call, no Celery) --------------
# how long it waits for Egress to close the recording file before linking it
RECORDING_WAIT_SECONDS=10

# --- Logs ----------------------------------------------------------------------------
# logs/<service>/<date>.jsonl, and one folder per call in data/calls/<call_id>/
LOGS_DIR=logs
LOG_LEVEL=INFO
LOG_KEEP_DAYS=30
# save the full messages of every LLM request in data/calls/<call_id>/llm.jsonl (0 = replies and numbers only)
LOG_LLM_MESSAGES=1
CALLS_DIR=data/calls

# --- Call recording (LiveKit Egress, both sides of the call) -----------------------
# On by default on the server (docker-compose.yml). Files: data/recordings/<room>.ogg,
# linked into each call's folder as recording.ogg. Needs Egress + Redis, so it is off on a laptop.
# The server ignores this line; turn recording off there with SERVER_RECORDING_ENABLED=0.
RECORDING_ENABLED=0
# RECORDING_S3_BUCKET=ev-call-recordings
# RECORDING_S3_REGION=me-central-1

# --- Phone calls through 3CX (later) -----------------------------------------------
# The LiveKit SIP outbound trunk that points at 3CX. Empty = terminal and browser calls only.
# SIP_OUTBOUND_TRUNK_ID=ST_xxxxxxxxxxxx
RING_TIMEOUT=30
# where "transfer to a person" goes: a 3CX extension or a number. Empty = the agent offers a callback.
# HUMAN_TRANSFER_TO=sip:201@your-3cx-host
