# Copy to .env and fill in. One file for the server (docker compose) and the laptop (agent.talk).

# --- LiveKit (self-hosted on the company GPU server) -----------------------------
# On the server, docker-compose.yml overrides this with ws://127.0.0.1:7880.
# On a laptop, point it at the server: ws://<server-ip>:7880
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
# at least 32 characters
LIVEKIT_API_SECRET=change-me-to-a-long-random-secret-0123456789
# LiveKit is on the LAN, so the agent connects to it directly. Set this only if it must go through a proxy.
# LIVEKIT_HTTP_PROXY=

# --- Call settings ---------------------------------------------------------------
COMPANY_NAME=Horizon Realty
AGENT_PERSONA_NAME=Alex
CALL_TIMEZONE=UTC
DEFAULT_LEAD_ID=L001

# --- CRM ---------------------------------------------------------------------------
CRM_BACKEND=sqlite
CRM_SQLITE_PATH=data/crm.db
# CRM_BACKEND=zoho
# ZOHO_CLIENT_ID=
# ZOHO_CLIENT_SECRET=
# ZOHO_REFRESH_TOKEN=
# ZOHO_DC=com
# ZOHO_SANDBOX=true

# --- LLM: Qwen3.5-9B on vLLM -------------------------------------------------------
# LLM_MODEL is the name vLLM serves the model under (--served-model-name).
LLM_MODEL=qwen3.5-9b
# Hugging Face model vLLM downloads and serves
VLLM_MODEL=Qwen/Qwen3.5-9B
# empty = no key. If set, vLLM requires it and the agent sends it.
LLM_API_KEY=
LLM_TEMPERATURE=0.3
# seconds the agent waits for the LLM's first token
LLM_TIMEOUT=30
# vLLM tuning (services/docker-compose.yml):
#   share of GPU memory for vLLM; STT and TTS use the rest
VLLM_GPU_UTIL=0.55
VLLM_MAX_MODEL_LEN=16384
#   calls answered at the same time
VLLM_MAX_NUM_SEQS=48
#   24 GB GPU: VLLM_EXTRA_ARGS=--quantization fp8   and VLLM_GPU_UTIL=0.6
# VLLM_EXTRA_ARGS=
# VLLM_IMAGE_TAG=v0.27.1
# HF_TOKEN=

# Service URLs. On the server docker-compose.yml sets these itself (127.0.0.1).
# On a laptop (agent.check, or running the agent there), use the server's address:
LLM_BASE_URL=http://localhost:8000/v1
STT_BASE_URL=http://localhost:8001/v1
TTS_BASE_URL=http://localhost:8880/v1

STT_MODEL=whisper-1
TTS_VOICE=af_heart
# model = LiveKit's local turn detector (needs `python -m agent.main download-files`); vad = silence only
TURN_DETECTION=model

# --- Post-call work: Celery on Redis -----------------------------------------------
# On the server docker-compose.yml sets this. Empty = post-call work runs inside the agent.
# REDIS_URL=redis://localhost:6379/0
# how long the postcall worker waits for the recording file to be closed
RECORDING_WAIT_SECONDS=20

# --- Logs ----------------------------------------------------------------------------
# logs/<service>/<date>.jsonl, and one folder per call in data/calls/<call_id>/
LOGS_DIR=logs
LOG_LEVEL=INFO
LOG_KEEP_DAYS=30
# save the full messages of every LLM request in data/calls/<call_id>/llm.jsonl (0 = replies and numbers only)
LOG_LLM_MESSAGES=1
CALLS_DIR=data/calls

# --- Call recording (LiveKit Egress, both sides of the call) -----------------------
# On by default on the server (docker-compose.yml). Files: data/recordings/<room>.ogg,
# linked into each call's folder as recording.ogg.
RECORDING_ENABLED=1
# RECORDING_S3_BUCKET=ev-call-recordings
# RECORDING_S3_REGION=me-central-1

# --- Phone calls through 3CX (later) -----------------------------------------------
# The LiveKit SIP outbound trunk that points at 3CX. Empty = terminal and browser calls only.
# SIP_OUTBOUND_TRUNK_ID=ST_xxxxxxxxxxxx
RING_TIMEOUT=30
# where "transfer to a person" goes: a 3CX extension or a number. Empty = the agent offers a callback.
# HUMAN_TRANSFER_TO=sip:201@your-3cx-host
